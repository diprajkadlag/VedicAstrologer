# Optional: override the public Nominatim search endpoint.
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search

# Use a descriptive identifier with real contact details in production.
NOMINATIM_USER_AGENT="VedicAstrologer/0.1 (contact: you@example.com)"

# Build-time switches read by next.config.ts (not needed for `npm run dev`).
# STATIC_EXPORT=1 produces the serverless folder build used by GitHub Pages;
# BASE_PATH is the sub-path a project page is served from, e.g. /VedicAstrologer.
# STATIC_EXPORT=1
# BASE_PATH=/VedicAstrologer
